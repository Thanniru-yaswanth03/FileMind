{
  "name": "filemind",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "core:build": "cargo build --manifest-path crates/filemind-core/Cargo.toml",
    "core:test": "cargo test --manifest-path crates/filemind-core/Cargo.toml",
    "core:run": "cargo run --manifest-path crates/filemind-core/Cargo.toml",
    "package:portable": "powershell -ExecutionPolicy Bypass -File scripts/package-release.ps1 -PortableOnly",
    "package:all": "powershell -ExecutionPolicy Bypass -File scripts/package-release.ps1"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}